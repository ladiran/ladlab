# Project-root rewrite: lets http://localhost/clearsky_academy/ work on WAMP without a virtual host.
# For production, point the web server's document root at the /public folder instead.
Options -Indexes
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^$ public/ [L]
RewriteRule ^(?!public/)(.*)$ public/$1 [L]
</IfModule>

# Never serve version-control files (.git, .gitignore), in case the site is run from a folder cloned with git.
<IfModule mod_alias.c>
RedirectMatch 404 /\.git
</IfModule>
