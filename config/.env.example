# Copy to .env (the web installer does this for you).

# local or production
APP_ENV=local
# 1 shows errors (local only), 0 hides them
APP_DEBUG=1
# Optional, e.g. https://clearskyacademy.com ; leave blank to auto-detect
APP_URL=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=clearsky_academy
DB_USER=root
# Type the password here only for the first run, then run:  php tools/secure_config.php
# which replaces it with an encrypted DB_PASS_ENC line (the key lives in storage/keys/app.key).
DB_PASS=

# Mail mode: log (writes to storage/logs/mail.log, nothing is sent), mail (PHP mail()) or smtp
MAIL_MODE=log
MAIL_FROM=hello@clearskyacademy.com
MAIL_FROM_NAME=ClearSky Academy
SMTP_HOST=
SMTP_PORT=587
# tls, ssl or none
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASS=

# Behind a proxy (Cloudflare tunnel on this machine needs nothing). Another proxy address:
# TRUSTED_PROXIES=203.0.113.10
# Keep the encryption key outside the website folder (recommended on a live server):
# APP_KEY_FILE=/home/you/keys/clearsky.key

# Testing only: set to 1 to let the news fetcher use http:// and localhost feeds (ignored when APP_ENV=production)
NEWS_ALLOW_LOCAL=0
